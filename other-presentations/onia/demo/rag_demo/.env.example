# Copy this file to .env and adjust if your LM Studio server is on a
# different host/port or your model identifiers differ.

# OpenAI-compatible base URL of the LM Studio local server.
# Default for LM Studio is http://127.0.0.1:1234/v1
OPENAI_BASE_URL=http://127.0.0.1:1234/v1

# LM Studio ignores the API key, but the OpenAI SDK requires one to be set.
OPENAI_API_KEY=lm-studio

# Chat model identifier as shown in LM Studio (My Models).
CHAT_MODEL=qwen/qwen3.5-9b

# Embedding model identifier as shown in LM Studio.
EMBEDDING_MODEL=text-embedding-qwen3-embedding-4b

# How many RAG passages to retrieve per query.
TOP_K=3
